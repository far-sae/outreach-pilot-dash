# Copy to `.env` and fill in. Never commit the real file.

# ---------------------------------------------------------------- Supabase ----
# Project settings → API keys. The publishable key is safe in the browser:
# row level security restricts it to the signed-in user's own rows.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ------------------------------------------------------------- public URL ----
# Base URL for open-tracking and unsubscribe links. No VITE_ prefix, so it stays
# server-side.
#
# Recipients open these from their own mail client, which cannot resolve
# localhost. Unset is fine for local testing (it falls back to the request
# origin), but it MUST be set before sending to real prospects.
# APP_URL="https://outreach.yourdomain.com"

# ----------------------------------------------------------- send worker -----
# Required only by `npm run worker`. The worker has no user session, so it needs
# the service_role key to satisfy row level security.
#
# This key bypasses ALL row level security. Keep it server-side, never give it a
# VITE_ prefix, and never paste it into client code.
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# How often the worker polls, and how many messages it sends per user per cycle.
# WORKER_INTERVAL_MS="15000"
# WORKER_BATCH="50"
